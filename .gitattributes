# 默认按文本处理，检出为 LF
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# 二进制：不做换行转换，不做 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.docx  binary
*.doc   binary
*.pptx  binary
*.xlsx  binary
*.zst   binary

