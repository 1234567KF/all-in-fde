{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../.cache/tsc/scripts.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types", "node"],
    "typeRoots": [
      "../apps/api/node_modules",
      "../apps/api/node_modules/@types"
    ],
    "paths": {
      "typescript": [
        "../apps/api/node_modules/typescript",
        "../apps/web/node_modules/typescript",
        "../frontend/node_modules/typescript",
        "../node_modules/typescript"
      ]
    }
  },
  "include": [
    "*.ts",
    "lib/*.ts",
    "gen-module/*.ts",
    "../tools/scaffolder/scripts/**/*.ts"
  ]
}
